<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_move_form_inherit_journal_type" model="ir.ui.view">
        <field name="name">account.move.form.inherit.journal.type</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='delivery_date']" position="after">
                <field name="journal_type" />
            </xpath>
        </field>
    </record>
</odoo>
