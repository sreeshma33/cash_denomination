<!--                            alert("Cash transferred successfully!");-->
<!--                        })-->
<!--                        .catch(() => {-->
<!--                            alert("Transfer failed! Please try again.");-->
<!--                        });-->
<!--                    });-->

                });

            </script>

        </t>
    </template>
</odoo>
